<link rel="stylesheet" href="{{ asset('css/message-modal.css') }}">
<script src="{{ asset('js/message-modal.js') }}"></script>
{# Flash Message Luxury Modal Component #}
{% set all_flashes = modal_flashes|default([]) %}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        {% set normalized_type = (label in ['error', 'danger']) ? 'error' : ((label == 'warning') ? 'warning' : 'success') %}
        {% set all_flashes = all_flashes|merge([{'type': normalized_type, 'message': message}]) %}
    {% endfor %}
{% endfor %}

<div id="flashModalBackdrop" class="flash-modal-backdrop" data-return-url="{{ modal_return_url|default('') }}" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="flashModalTitle" aria-describedby="flashModalBody">
    <div class="flash-modal-container">
        <div class="flash-modal-card">
            <button type="button" class="flash-modal-close" id="flashModalCloseBtn" aria-label="Close modal">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
            <div class="flash-modal-icon-wrap" id="flashModalIconWrap">
                <!-- SVG Icon injected by type -->
            </div>
            <h3 class="flash-modal-title" id="flashModalTitle">Notice</h3>
            <div class="flash-modal-body" id="flashModalBody">
                <!-- Message content -->
            </div>
            <div class="flash-modal-footer">
                <button type="button" class="flash-modal-btn" id="flashModalActionBtn">{{ modal_return_url|default('') ? 'Back to store' : 'Dismiss' }}</button>
            </div>
        </div>
    </div>
</div>

<style>
.flash-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 999999;
    background: rgba(0, 0, 0, 0.78);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    transition: opacity 0.25s ease;
}
.flash-modal-backdrop.is-active {
    opacity: 1;
}
.flash-modal-container {
    width: 100%;
    max-width: 440px;
}
.flash-modal-card {
    position: relative;
    background: #141416;
    background: linear-gradient(145deg, rgba(28, 28, 32, 0.98), rgba(16, 16, 18, 0.98));
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 25px 60px -12px rgba(0, 0, 0, 0.8), 0 0 40px rgba(113, 65, 107, 0.15);
    border-radius: 18px;
    padding: 34px 30px 28px;
    text-align: center;
    transform: scale(0.92) translateY(12px);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}
.flash-modal-backdrop.is-active .flash-modal-card {
    transform: scale(1) translateY(0);
}
.flash-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: transparent;
    border: none;
    color: #888;
    cursor: pointer;
    padding: 6px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
}
.flash-modal-close:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
}
.flash-modal-icon-wrap {
    width: 64px;
    height: 64px;
    margin: 0 auto 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}
.flash-modal-icon-wrap.is-success {
    background: rgba(46, 204, 113, 0.12);
    color: #2ecc71;
    border: 1px solid rgba(46, 204, 113, 0.3);
    box-shadow: 0 0 25px rgba(46, 204, 113, 0.2);
}
.flash-modal-icon-wrap.is-error {
    background: rgba(231, 76, 60, 0.12);
    color: #e74c3c;
    border: 1px solid rgba(231, 76, 60, 0.3);
    box-shadow: 0 0 25px rgba(231, 76, 60, 0.2);
}
.flash-modal-icon-wrap.is-warning {
    background: rgba(241, 196, 15, 0.12);
    color: #f1c40f;
    border: 1px solid rgba(241, 196, 15, 0.3);
    box-shadow: 0 0 25px rgba(241, 196, 15, 0.2);
}
.flash-modal-title {
    font-family: var(--font-heading, 'Playfair Display', serif);
    font-size: 1.35rem;
    font-weight: 500;
    margin: 0 0 10px;
    color: #fff;
    letter-spacing: 0.5px;
}
.flash-modal-body {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.95rem;
    color: #b5b5b5;
    line-height: 1.55;
    margin-bottom: 24px;
    word-break: break-word;
}
.flash-modal-footer {
    display: flex;
    justify-content: center;
}
.flash-modal-btn {
    width: 100%;
    padding: 12px 24px;
    border-radius: 8px;
    border: none;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.25s ease;
    background: var(--accent, #71416B);
    color: #fff;
}
.flash-modal-btn:hover {
    filter: brightness(1.15);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(113, 65, 107, 0.4);
}
.flash-modal-btn.btn-error {
    background: #e74c3c;
}
.flash-modal-btn.btn-error:hover {
    box-shadow: 0 6px 20px rgba(231, 76, 60, 0.4);
}
</style>

<script>
(function() {
    var modalBackdrop = document.getElementById('flashModalBackdrop');
    var modalTitle = document.getElementById('flashModalTitle');
    var modalBody = document.getElementById('flashModalBody');
    var modalIconWrap = document.getElementById('flashModalIconWrap');
    var modalActionBtn = document.getElementById('flashModalActionBtn');
    var modalCloseBtn = document.getElementById('flashModalCloseBtn');

    var icons = {
        success: '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>',
        error: '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>',
        warning: '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>'
    };

    function showModal(type, title, message) {
        if (!modalBackdrop) return;
        type = (type === 'danger' || type === 'error') ? 'error' : (type === 'warning' ? 'warning' : 'success');
        modalIconWrap.className = 'flash-modal-icon-wrap is-' + type;
        modalIconWrap.innerHTML = icons[type] || icons.success;
        modalTitle.textContent = title || (type === 'error' ? 'Notice' : (type === 'warning' ? 'Attention' : 'Success'));
        modalBody.innerHTML = message || '';
        
        if (type === 'error') {
            modalActionBtn.className = 'flash-modal-btn btn-error';
        } else {
            modalActionBtn.className = 'flash-modal-btn';
        }

        modalBackdrop.style.display = 'flex';
        // Force reflow
        void modalBackdrop.offsetWidth;
        modalBackdrop.classList.add('is-active');
        document.body.style.overflow = 'hidden';
    }

    function closeModal() {
        if (!modalBackdrop) return;
        if (modalBackdrop.dataset.returnUrl) {
            window.location.assign(modalBackdrop.dataset.returnUrl);
            return;
        }
        modalBackdrop.classList.remove('is-active');
        setTimeout(function() {
            modalBackdrop.style.display = 'none';
            document.body.style.overflow = '';
        }, 250);
    }

    if (modalActionBtn) modalActionBtn.addEventListener('click', closeModal);
    if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
    if (modalBackdrop) {
        modalBackdrop.addEventListener('click', function(e) {
            if (e.target === modalBackdrop) closeModal();
        });
    }

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modalBackdrop && modalBackdrop.classList.contains('is-active')) {
            closeModal();
        }
    });

    window.showAppModal = showModal;
    window.closeAppModal = closeModal;

    // Check if Symfony passed any flashes
    var initialFlashes = {{ all_flashes|json_encode|raw }};
    if (initialFlashes && initialFlashes.length > 0) {
        var first = initialFlashes[0];
        var combinedMessage = initialFlashes.map(function(f) { return f.message; }).join('<br><br>');
        var defaultTitle = first.type === 'error' ? 'Notice' : 'Success';
        showModal(first.type, defaultTitle, combinedMessage);
    }
})();
</script>
