<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content">
    <title>{% block title %}Admin Dashboard{% endblock %} — Maison Ungod</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <link rel="stylesheet" href="{{ asset('admin/css/admin.css') }}">
    {% block stylesheets %}{% endblock %}
<link rel="stylesheet" href="{{ asset('css/qa.css') }}?v=20261110-2">
</head>
<body>
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <div class="brand-logo">
                <img src="{{ asset('assets/logo/logo.png') }}" width="28" height="28" alt="Logo" style="object-fit: contain;">
                <div class="brand-text">
                    <span class="brand-title">Maison Ungod</span>
                    <span class="brand-subtitle">{{ is_granted('ROLE_ADMIN') ? 'ADMIN PANEL' : 'STAFF WORKSPACE' }}</span>
                </div>
            </div>
        </div>
        <div class="sidebar-menu-title">MENU</div>
        <nav class="sidebar-nav">
            {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_admin_dashboard') }}" class="{% if app.request.attributes.get('_route') == 'app_admin_dashboard' %}active{% endif %}">
                <i class="ph ph-house"></i> Dashboard
            </a>
            <a href="{{ path('app_admin_product_index') }}" class="{% if 'product' in app.request.attributes.get('_route') %}active{% endif %}">
                <i class="ph ph-cube"></i> Products
            </a>
            <a href="{{ path('app_admin_order_index') }}" class="{% if 'order' in app.request.attributes.get('_route') %}active{% endif %}">
                <i class="ph ph-shopping-bag"></i> Orders
            </a>
            <a href="{{ path('app_admin_user_index') }}" class="{% if 'user' in app.request.attributes.get('_route') %}active{% endif %}">
                <i class="ph ph-users"></i> Users
            </a>
            <a href="{{ path('app_admin_contact_index') }}" class="{% if 'contact' in app.request.attributes.get('_route') %}active{% endif %}">
                <i class="ph ph-envelope"></i> Messages
            </a>
            {% elseif is_granted('ROLE_STAFF') %}
            <a href="{{ path('app_staff_product_index') }}" class="{{ 'product' in app.request.attributes.get('_route') ? 'active' : '' }}"><i class="ph ph-cube" aria-hidden="true"></i> Products</a>
            <a href="{{ path('app_staff_order_index') }}" class="{{ 'order' in app.request.attributes.get('_route') ? 'active' : '' }}"><i class="ph ph-shopping-bag" aria-hidden="true"></i> Orders</a>
            {% endif %}
            <a href="{{ path('app_account') }}"><i class="ph ph-user" aria-hidden="true"></i> My profile &amp; password</a>
        </nav>
        
        <div class="sidebar-menu-title" style="margin-top: 30px;">STORE</div>
        <nav class="sidebar-nav">
            <a href="{{ path('app_home') }}"><i class="ph ph-arrow-square-out"></i> View Store</a>
        </nav>
        
        <div class="sidebar-bottom">
            <div class="admin-profile">
                <div class="profile-avatar">
                    {% if app.user %}
                        {{ app.user.fullName|slice(0, 1)|upper }}{{ app.user.fullName|split(' ')|length > 1 ? app.user.fullName|split(' ')[1]|slice(0, 1)|upper : '' }}
                    {% else %}
                        AD
                    {% endif %}
                </div>
                <div class="profile-info">
                    <span class="profile-name">{{ app.user ? app.user.fullName : 'Admin' }}</span>
                    <span class="profile-role">{{ is_granted('ROLE_ADMIN') ? 'Administrator' : 'Staff' }}</span>
                </div>
                <a href="{{ logout_path() }}" class="logout-btn" title="Logout"><i class="ph ph-sign-out"></i></a>
            </div>
        </div>
    </aside>

    <a class="skip-link" href="#management-content">Skip to content</a>
    <main class="admin-main" id="management-content">
        <header class="admin-header">
            <h2 id="pageTitle">{% block page_title %}Welcome back, {{ app.user ? app.user.fullName : 'Admin' }}! 👋{% endblock %}</h2>
        </header>
        <div class="admin-content">
            {% include 'partials/_flash_messages.html.twig' %}

            {% block content %}{% endblock %}
        </div>
    </main>

    <script src="{{ asset('js/management.js') }}" defer></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
