{% extends 'admin/base.html.twig' %}

{% set productRoutes = app.request.attributes.get('_route') starts with 'app_staff_' ? 'app_staff_product_' : 'app_admin_product_' %}
{% block title %}Manage Products{% endblock %}
{% block page_title %}{{ block('title') }}{% endblock %}

{% block content %}
<form method="get" class="qa-catalog-filters admin-search-form" role="search">
    <label class="admin-search-field">
        <span class="sr-only">Search</span>
        <input type="search" name="q" value="{{ app.request.query.get('q') }}" maxlength="100" placeholder="Search products..." aria-label="Search products">
    </label>
    <label><span class="sr-only">Product status</span>
        <select name="status" aria-label="Filter by product status">
            <option value="">All statuses</option>
            {% for status in ['Active', 'Inactive'] %}
            <option value="{{ status }}" {{ app.request.query.get('status') == status ? 'selected' : '' }}>{{ status }}</option>
            {% endfor %}
        </select>
    </label>
    <button type="submit" class="admin-search-btn">Search</button>
    {% if app.request.query.get('q') or app.request.query.get('status') %}
        <a href="{{ path(productRoutes ~ 'index') }}" class="admin-search-clear">Clear</a>
    {% endif %}
</form>
{% if not is_granted('ROLE_ADMIN') %}<p class="management-note">You can view all products, but edit or delete only products you created. Products with order history are archived when deleted.</p>{% endif %}
<div class="management-toolbar product-catalog-toolbar">
    <h3 style="font-family: var(--font-heading); color: var(--accent); margin:0;">Product Catalog</h3>
        <a href="{{ path(productRoutes ~ 'new') }}" class="btn product-catalog-add">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Add Product
        </a>
</div>

<div class="admin-table-container">
    <table class="admin-table" id="productsTable">
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Status</th>
                {% if is_granted('ROLE_ADMIN') %}<th>Created by</th>{% endif %}
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="productsTableBody">
            {% for product in products %}
                <tr>
                    <td>
                        {% if product.image %}
                            <img src="{{ asset(product.image|default('assets/logo/logo.png')) }}" alt="Product" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px;" onerror="this.src='{{ asset('images/placeholder.webp') }}'">
                        {% else %}
                            <div style="width: 40px; height: 40px; border-radius: 4px; background: #222; display: flex; align-items: center; justify-content: center; font-size: 10px; color: #666;">No Img</div>
                        {% endif %}
                    </td>
                    <td>{{ product.name }}</td>
                    <td>{{ product.category ? product.category.name : 'Uncategorized' }}</td>
                    <td>₱{{ product.price|number_format(2) }}</td>
                    <td>{{ product.stock }}</td>
                    <td>
                        <span style="display:inline-block; padding: 2px 8px; border-radius: 12px; font-size: 12px; background: {% if product.status == 'Active' %}rgba(46, 204, 113, 0.2){% else %}rgba(255, 255, 255, 0.1){% endif %}; color: {% if product.status == 'Active' %}#2ecc71{% else %}#aaa{% endif %};">
                            {{ product.status }}
                        </span>
                    </td>
                    {% if is_granted('ROLE_ADMIN') %}<td>{{ product.createdBy ? product.createdBy.fullName : 'Not recorded' }}</td>{% endif %}
                    <td>
                        <div style="display:flex; gap: 5px;">
                            {% if not is_granted('PRODUCT_EDIT', product) %}<span class="management-note">View only</span>{% endif %}
                            {% if is_granted('PRODUCT_EDIT', product) %}<a href="{{ path(productRoutes ~ 'edit', {'id': product.id}) }}" class="btn" style="padding: 4px 8px; font-size: 12px;">Edit</a>{% endif %}
                            {% if is_granted('PRODUCT_DELETE', product) %}<form action="{{ path(productRoutes ~ 'delete', {'id': product.id}) }}" method="POST" style="display:inline;" data-confirm="Delete this product? Products with order history will be archived." data-confirm-title="Delete Product" data-confirm-button="Delete">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                                <button type="submit" class="btn" style="padding: 4px 8px; font-size: 12px; background-color: #e74c3c; color: white;">Delete</button>
                            </form>{% endif %}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="{{ is_granted('ROLE_ADMIN') ? 8 : 7 }}" style="text-align:center;">No products found.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% include 'partials/_pagination.html.twig' %}
{% endblock %}
