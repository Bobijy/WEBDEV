{% extends 'admin/base.html.twig' %}

{% block title %}Manage Products{% include 'partials/_pagination.html.twig' %}
{% endblock %}
{% block page_title %}Manage Products{% endblock %}

{% block content %}
<form method="get" class="qa-catalog-filters admin-search-form" role="search">
    <label class="admin-search-field">
        <span class="sr-only">Search</span>
        <input type="search" name="q" value="{{ app.request.query.get('q') }}" maxlength="100" placeholder="Search products..." aria-label="Search products">
    </label>
    <button type="submit" class="admin-search-btn">Search</button>
    {% if app.request.query.get('q') %}
        <a href="{{ path('app_admin_product_index') }}" class="admin-search-clear">Clear</a>
    {% endif %}
</form>
<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 20px;">
    <h3 style="font-family: var(--font-heading); color: var(--accent); margin:0;">Product Catalog</h3>
    <div style="display:flex; gap:10px;">
        <a href="{{ path('app_admin_product_new') }}" class="btn" style="display:inline-flex; align-items:center; gap:8px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Add Product
        </a>
    </div>
</div>

<div class="admin-table-container">
    <table class="admin-table" id="productsTable">
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="productsTableBody">
            {% for product in products %}
                <tr>
                    <td>
                        {% if product.image %}
                            <img src="{{ asset(product.image|default('assets/logo/logo.png')) }}" alt="Product" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px;" onerror="this.src='{{ asset('images/placeholder.webp') }}'">
                        {% else %}
                            <div style="width: 40px; height: 40px; border-radius: 4px; background: #222; display: flex; align-items: center; justify-content: center; font-size: 10px; color: #666;">No Img</div>
                        {% endif %}
                    </td>
                    <td>{{ product.name }}</td>
                    <td>{{ product.category ? product.category.name : 'Uncategorized' }}</td>
                    <td>₱{{ product.price|number_format(2) }}</td>
                    <td>{{ product.stock }}</td>
                    <td>
                        <span style="display:inline-block; padding: 2px 8px; border-radius: 12px; font-size: 12px; background: {% if product.status == 'Active' %}rgba(46, 204, 113, 0.2){% else %}rgba(255, 255, 255, 0.1){% endif %}; color: {% if product.status == 'Active' %}#2ecc71{% else %}#aaa{% endif %};">
                            {{ product.status }}
                        </span>
                    </td>
                    <td>
                        <div style="display:flex; gap: 5px;">
                            <a href="{{ path('app_admin_product_edit', {'id': product.id}) }}" class="btn" style="padding: 4px 8px; font-size: 12px;">Edit</a>
                            <form action="{{ path('app_admin_product_delete', {'id': product.id}) }}" method="POST" style="display:inline;" data-confirm="Are you sure you want to delete this product?" data-confirm-title="Delete Product" data-confirm-button="Delete">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                                <button type="submit" class="btn" style="padding: 4px 8px; font-size: 12px; background-color: #e74c3c; color: white;">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" style="text-align:center;">No products found.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
