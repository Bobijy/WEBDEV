{% extends 'base.html.twig' %}

{% block title %}Conversation{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/pages/account.css') }}?v=9">
{% endblock %}

{% block body %}
<div class="account-page-wrapper conversation-page">
<div class="account-layout">
    <div class="account-container" style="max-width: 800px; margin: 0 auto; padding: 40px 20px;">
        <div style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
            <h2 style="font-family: var(--font-heading); color: var(--text-main); margin: 0;">Conversation Thread</h2>
            <a href="{{ path('app_account', {'tab': 'messages'}) }}" class="btn-outline" style="text-decoration:none; padding: 8px 16px; border: 1px solid rgba(255,255,255,0.2); border-radius: 4px; color: var(--text-main);">Back to Messages</a>
        </div>

        <div style="background: rgba(255, 255, 255, 0.02); padding: 30px; border-radius: 12px; display: flex; flex-direction: column; gap: 20px; border: 1px solid rgba(255,255,255,0.05);">
            
            <!-- Initial Message -->
            <div style="align-self: flex-end; max-width: 80%;">
                <div style="font-size: 0.8rem; color: var(--text-light); margin-bottom: 5px; text-align: right;">You - {{ message.createdAt|date('M j, Y H:i') }}</div>
                <div style="background: var(--brand-color); padding: 15px 20px; border-radius: 12px; border-top-right-radius: 2px; color: white; line-height: 1.5;">
                    {{ message.message|nl2br }}
                </div>
            </div>

            <!-- Replies -->
            {% for reply in message.replies %}
                {% if reply.isFromAdmin() %}
                    <div style="align-self: flex-start; max-width: 80%;">
                        <div style="font-size: 0.8rem; color: var(--text-light); margin-bottom: 5px;">Maison Ungod Support - {{ reply.createdAt|date('M j, Y H:i') }}</div>
                        <div style="background: rgba(255, 255, 255, 0.05); padding: 15px 20px; border-radius: 12px; border-top-left-radius: 2px; color: var(--text-main); line-height: 1.5; border: 1px solid rgba(255,255,255,0.1);">
                            {{ reply.message|nl2br }}
                        </div>
                    </div>
                {% else %}
                    <div style="align-self: flex-end; max-width: 80%;">
                        <div style="font-size: 0.8rem; color: var(--text-light); margin-bottom: 5px; text-align: right;">You - {{ reply.createdAt|date('M j, Y H:i') }}</div>
                        <div style="background: var(--brand-color); padding: 15px 20px; border-radius: 12px; border-top-right-radius: 2px; color: white; line-height: 1.5;">
                            {{ reply.message|nl2br }}
                        </div>
                    </div>
                {% endif %}
            {% endfor %}

            <!-- Reply Form -->
            <div style="margin-top: 20px; border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 20px;">
                <form method="post" action="{{ path('app_account_message_show', {'id': message.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('reply') }}">
                    <div style="margin-bottom: 15px;">
                        <textarea aria-label="Reply message" maxlength="5000" name="reply_message" rows="4" style="width: 100%; background: #171717; border: 1px solid #2E2E2E; color: white; padding: 15px; border-radius: 8px; font-family: inherit; resize: vertical;" placeholder="Type your reply here..." required></textarea>
                    </div>
                    <div style="text-align: right;">
                        <button type="submit" style="padding: 10px 20px; background: var(--brand-color); color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 500;">Send Reply</button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>
</div>
{% endblock %}
