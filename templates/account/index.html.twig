        <button onclick="document.getElementById('addressModalOverlay').style.display='none'" style="position: absolute; top: 15px; right: 15px; background: none; border: none; font-size: 24px; cursor: pointer; color: #888; display: flex; align-items: center; justify-content: center;">&times;</button>
