<script>
function openAddressModal(id = null, fullName = '', phone = '', firstName = '', lastName = '', country = '', barangay = '', postalCode = '', city = '', region = '', addressLine1 = '') {
    document.getElementById('modal_address_id').value = id || '';
    
    fullName = fullName || '{{ user.fullName|default('')|escape('js') }}';
    phone = phone || '{{ user.phone|default('')|escape('js') }}';
    
    if (!firstName && !lastName && fullName) {
        let names = fullName.split(' ');
        firstName = names.shift() || '';
        lastName = names.join(' ') || '';
    }
    
    document.getElementById('new_firstName').value = firstName;
    document.getElementById('new_lastName').value = lastName;
    document.getElementById('new_phone').value = phone;
    
    if (country && document.querySelector(`#new_country option[value="${country}"]`)) {
        document.getElementById('new_country').value = country;
    }
    document.getElementById('new_postalCode').value = postalCode || '';
    if (region && document.querySelector(`#new_region option[value="${region}"]`)) {
        document.getElementById('new_region').value = region;
    }
    document.getElementById('new_city').value = city || '';
    document.getElementById('new_barangay').value = barangay || '';
    
    // If addressLine1 is empty but they have a legacy streetAddress, we try to parse it
    if (!addressLine1 && !city && id) {
        // Fallback for legacy concatenated addresses
        let parts = addressLine1 ? addressLine1.split(', ') : [];
        if (parts.length >= 5) {
            document.getElementById('new_addressLine1').value = parts.join(', ') || '';
        } else {
            document.getElementById('new_addressLine1').value = addressLine1;
        }
    } else {
        // We actually just pass streetAddress in the addressLine1 parameter from the template
        // Wait, streetAddress is the full concatenated string if it's a legacy record.
        // Let's just put it in addressLine1 for now if they don't have individual fields.
        // If they do have individual fields, we should theoretically separate them, but in our controller
        // we saved streetAddress as the concatenated string.
        // Actually, if we pass streetAddress as the last param, and they have NO city/postal code (newly migrated),
        // we can try splitting streetAddress here.
        let parts = addressLine1 ? addressLine1.split(', ') : [];
        if (parts.length >= 5 && !city) {
            let pCountry = parts.pop();
            if (document.querySelector(`#new_country option[value="${pCountry}"]`)) document.getElementById('new_country').value = pCountry;
            document.getElementById('new_postalCode').value = parts.pop() || '';
            let pRegion = parts.pop();
            if (document.querySelector(`#new_region option[value="${pRegion}"]`)) document.getElementById('new_region').value = pRegion;
            document.getElementById('new_city').value = parts.pop() || '';
            if (parts.length > 1) {
                document.getElementById('new_barangay').value = parts.pop() || '';
            }
            document.getElementById('new_addressLine1').value = parts.join(', ') || '';
        } else {
            // For new records where addressLine1 IS just addressLine1, wait we didn't save addressLine1 separately!
            // In the controller, we only saved $streetAddress as the full concatenated string.
            // But we DID save firstName, lastName, city, etc.!
            // So if `city` exists, then `addressLine1` (which is streetAddress in DB) is the full string!
            // This means we still need to extract addressLine1 from it, OR we should have saved addressLine1 in the DB!
            // For now, if city exists, we just put streetAddress as addressLine1. (They can edit it).
            document.getElementById('new_addressLine1').value = addressLine1;
        }
    }

    document.getElementById('addressModalTitle').innerText = id ? 'Edit Address' : 'Add New Address';
    document.getElementById('addressModalOverlay').style.display = 'flex';
}
</script>
